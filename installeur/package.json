{
	"name": "project-launcher",
	"version": "0.1.0",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"start": "electron .",
		"dist:win": "electron-builder --win nsis"
	},
	"build": {
		"appId": "npcforge.fr",
		"files": [
			"*.{js,cjs,html}",
			"scripts/**",
			"package.json"
		],
		"extraResources": [
			{
				"from": "scripts/install-linux.sh",
				"to": "scripts/install-linux.sh"
			}
		],
		"nsis": {
			"oneClick": true,
			"perMachine": true,
			"allowElevation": true,
			"allowToChangeInstallationDirectory": false
		}
	},
	"dependencies": {
		"sudo-prompt": "^9.2.1"
	},
	"devDependencies": {
		"electron": "^38.4.0",
		"electron-builder": "^24.13.3",
		"keytar": "^7.9.0"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"description": ""
}
